// -*- mode: jsonc -*-
[
  // ===== Barra del Samsung (HDMI-A-1): corrida a la izquierda y hacia abajo =====
  {
    "output": "HDMI-A-1",
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 4,
    "margin-top": 10,
    "margin-right": 10,
    "margin-left": 0,
    "modules-left": ["custom/arch", "hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["idle_inhibitor", "pulseaudio", "network", "cpu", "memory",
                      "temperature", "hyprland/language", "backlight", "battery",
                      "battery#bat2", "clock"],
    "include": ["~/.config/waybar/modules.json"]
  },
  // ===== Barra de la portátil (eDP-1): igual que antes =====
  {
    "output": "eDP-1",
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 4,
    "modules-left": ["custom/arch", "hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["idle_inhibitor", "pulseaudio", "network", "cpu", "memory",
                      "temperature", "hyprland/language", "backlight", "battery",
                      "battery#bat2", "clock"],
    "include": ["~/.config/waybar/modules.json"]
  }
]
